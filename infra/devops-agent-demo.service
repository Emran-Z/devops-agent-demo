[Unit]
Description=DevOps Agent Demo — Flask App
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/devops-agent-demo-app
ExecStart=/opt/devops-agent-demo-app/venv/bin/gunicorn \
    --bind 0.0.0.0:5000 \
    --workers 2 \
    --access-logfile - \
    --error-logfile - \
    --log-level info \
    app:app
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=devops-agent-demo
Environment=PORT=5000

[Install]
WantedBy=multi-user.target
